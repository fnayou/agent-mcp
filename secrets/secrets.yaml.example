# Plaintext template for secrets/secrets.sops.yaml. Never put real values here.
#
# The loop, each step in your own terminal:
#   task sops:decrypt   writes the plaintext secrets/secrets.yaml (ignored by git)
#   edit secrets/secrets.yaml and replace every REPLACE_ME
#   task sops:encrypt   encrypts it to secrets/secrets.sops.yaml and removes the plaintext
# Then commit secrets/secrets.sops.yaml.
TELEGRAM_API_ID: REPLACE_ME
TELEGRAM_API_HASH: REPLACE_ME
